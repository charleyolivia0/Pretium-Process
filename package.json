{
  "name": "pretium-process",
  "version": "0.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:kill-port": "powershell -ExecutionPolicy Bypass -File ./scripts/kill-dev-port.ps1",
    "dev:restart": "npm run dev:kill-port && npm run dev",
    "convex:dev": "convex dev",
    "dev:convex": "concurrently -n convex,vite -c blue,green \"npm run convex:dev\" \"npm run dev\"",
    "dev:desktop": "concurrently \"npm:dev\" \"npm:electron\"",
    "electron": "electron .",
    "build": "vite build",
    "build:desktop": "npm run build",
    "companion:qt:build": "powershell -ExecutionPolicy Bypass -File ./scripts/shijima-qt-build.ps1",
    "companion:qt:fetch": "powershell -ExecutionPolicy Bypass -File ./scripts/shijima-qt-fetch-release.ps1",
    "companion:qt:run": "powershell -ExecutionPolicy Bypass -File ./scripts/shijima-qt-run.ps1",
    "companion:qt:mascot:build": "node ./scripts/create-shijima-girl-mascot.mjs",
    "companion:qt:mascot:install": "powershell -ExecutionPolicy Bypass -File ./scripts/shijima-qt-install-maya.ps1",
    "companion:qt:maya": "npm run companion:qt:mascot:build && npm run companion:qt:mascot:install && npm run companion:qt:run",
    "preview": "vite preview",
    "lint": "echo \"No lint configured\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests configured\""
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "latest",
    "@types/three": "^0.183.1",
    "class-variance-authority": "^0.7.1",
    "convex": "latest",
    "electron": "^41.0.3",
    "heic-to": "^1.4.2",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "three": "^0.183.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react-swc": "latest",
    "concurrently": "^9.2.1",
    "pngjs": "^7.0.0",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "^9.0.4"
  }
}
