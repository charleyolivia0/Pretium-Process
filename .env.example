# Convex deployment URL (from `npx convex dev` or dashboard)
# Copy to .env.local and fill in your deployment URL.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex site URL (for public forms / inventory webhook). Set in Convex dashboard too.
# VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Inventory JotForm webhook: set in Convex dashboard (not .env.local):
# npx convex env set JOTFORM_WEBHOOK_SECRET your_secret_here
# POST /jotform-inventory with header X-Webhook-Secret: your_secret_here

# Email (Gmail / Outlook) OAuth — set in Convex dashboard:
# npx convex env set CONVEX_SITE_URL https://your-deployment.convex.site
# npx convex env set APP_URL http://localhost:5173
# npx convex env set GMAIL_CLIENT_ID your_google_client_id
# npx convex env set GMAIL_CLIENT_SECRET your_google_client_secret
# npx convex env set OUTLOOK_CLIENT_ID your_microsoft_app_client_id
# npx convex env set OUTLOOK_CLIENT_SECRET your_microsoft_app_client_secret
# OAuth redirect URIs (register in Google / Azure):
#   {CONVEX_SITE_URL}/api/oauth/gmail/callback
#   {CONVEX_SITE_URL}/api/oauth/outlook/callback

# Local speech-to-text endpoint (offline daily report transcription).
# Provided by `local-stt/server.js` (see local-stt/README.md).
VITE_LOCAL_STT_URL=http://127.0.0.1:8787/transcribe

# AI provider keys (set these in Convex env vars for server actions).
# npx convex env set OPENAI_API_KEY your_openai_key_here
# Optional fallback for text-only features:
# npx convex env set GEMINI_API_KEY your_gemini_key_here

